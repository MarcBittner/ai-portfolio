# flotilla — copy to .env.local and fill. Never commit .env.local; keep secrets out of git.

# --- Public read-only showcase (SAFETY) ------------------------------------
# When 1, flotilla runs as a PUBLIC read-only demo: an unauthenticated visitor is a
# view-only `guest`, AND a GLOBAL kill-switch blocks EVERY mutation (provision /
# teardown / refresh / patch-push / config-write / access-mutation / backup-write)
# for ALL roles — even an authenticated super-admin — so the shared public fleet
# can never be changed. Leave UNSET/0 for the PRIVATE owner deploy (full RBAC).
# See lib/rbac.ts (publicReadonlyEnabled), lib/api.ts (withOperator), lib/auth.ts.
FLOTILLA_PUBLIC_READONLY=

# --- Dashboard auth (Clerk gate + break-glass) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
# Break-glass local login (scrypt hash, never plaintext). See lib/breakglass.ts.
BREAKGLASS_EMAIL=
BREAKGLASS_PASSWORD_HASH=
# Owner floor: comma-separated immutable super-admin emails — resolution always
# overrides them to super-admin and they can never be demoted/removed (so the
# deployer can't be locked out). Empty when unset. See lib/rbac.ts.
FLOTILLA_IMMUTABLE_SUPERADMINS=
# Optional self-service domain (e.g. "example.com"): a verified Clerk email on this
# domain with no stored row auto-provisions read-only on first login. Empty = off.
FLOTILLA_SELF_SERVICE_DOMAIN=

# --- Persistence ---
MONGODB_URI=
MONGODB_DB=flotilla

# --- Platform automation credentials (orchestration) ---
VERCEL_TOKEN=
VERCEL_TEAM=
CONVEX_TEAM_TOKEN=
# Account access token (what `npx convex login` writes to ~/.convex). Authorizes
# the management/big-brain API used to PROVISION fresh preview deployments,
# mint per-deployment admin keys, list cloud backups, and drive the HTTP data
# import. Required by the worker + the Backups tab.
CONVEX_ACCESS_TOKEN=
# Team/project the preview deployments live under. REQUIRED (no code defaults):
# CONVEX_TEAM_ID + CONVEX_PROJECT_ID resolve the project slug via the Convex mgmt
# API; set CONVEX_PROJECT_SLUG to skip that lookup entirely.
CONVEX_TEAM_SLUG=
CONVEX_TEAM_ID=
CONVEX_PROJECT_ID=
# CONVEX_PROJECT_SLUG=   # optional; resolved from team+project id when unset
# Per-managed-instance Clerk secret keys are stored in Mongo (clerkConfigs), not here.

# --- Managed deployment topology (safety guards) ---------------------------
# The shared/managed Convex deployments the tool must never SILENTLY overwrite.
# These drive the danger-gates in lib/deployments.ts. Both are OPTIONAL and fall
# back to baked defaults, BUT set FLOTILLA_PROD_CONVEX_DEPLOYMENT in every real
# environment so the PRODUCTION hard write/teardown block is active.
#   FLOTILLA_PROD_CONVEX_DEPLOYMENT — the production deployment name (hard block).
#   FLOTILLA_SHARED_DEPLOYMENTS     — "name:role,name:role" (roles: PRODUCTION,
#     staging-prod, staging-dev, ci, dev — PRODUCTION/staging-prod force PII masking).
FLOTILLA_PROD_CONVEX_DEPLOYMENT=
FLOTILLA_SHARED_DEPLOYMENTS=
# Vercel-project safety sets (comma-separated, lowercased; extend the baked defaults).
#   FLOTILLA_PROD_VERCEL_PROJECTS   — HARD prod write/teardown block (default: production)
#   FLOTILLA_SHARED_VERCEL_PROJECTS — deploys need dangerAck, teardown blocked
#                                  (default: staging,workspace,website)
FLOTILLA_PROD_VERCEL_PROJECTS=
FLOTILLA_SHARED_VERCEL_PROJECTS=
# Authenticated app routes the browser smoke test hits on each managed instance
# (comma-separated). Generic-fleet knob — set to YOUR app's routes. Default:
# /dashboard,/projects,/settings,/profile. See lib/testRunner.ts.
FLOTILLA_SMOKE_PATHS=

# --- GitHub (branch picker + snapshot blob store) ---
# GITHUB_TOKEN needs `repo` scope: lists branches of the managed app repo
# (GITHUB_REPO, "owner/repo") AND reads/writes snapshot blobs in the private
# snapshot repo. Optional for a public branch repo; required for the snapshot store.
GITHUB_TOKEN=
GITHUB_REPO=example-org/example-app
# Private repo (owner/name) holding Convex snapshot ZIPs as GitHub Release assets
# (replaces the old GridFS bucket — snapshots are 60–180 MB and must not live in the
# shared Atlas cluster). Blobs go under a single lazily-created release (tag `blobs`).
# REQUIRED for the snapshot store (no default); unset → the store degrades off.
SNAPSHOT_REPO=

# --- Patch push (upload a diff, redeploy an instance) ---
# POST /api/instances/[id]/patch-push accepts a unified diff (.patch/.diff),
# applies it on top of the instance's base branch as an ephemeral commit/branch,
# and redeploys the instance's OWN disposable target. Gated by the patchPush
# feature flag below AND requires a PUSH-scoped GITHUB_TOKEN (contents:write /
# `repo`) on GITHUB_REPO — the read-only branch picker token is not enough. Never
# touches prod/shared (patchPushGuard + the executor preflight enforce that).
# Feature flag env default (Config store, /app/config). OFF unless set.
FLOTILLA_FEATURE_PATCH_PUSH=

# --- PR-native lifecycle (feature-gated, default OFF) ---
# When the prNativeLifecycle flag is on, POST /api/webhooks/github rides the
# instance lifecycle on the GitHub PR lifecycle: PR opened ⇒ provision, push ⇒
# refresh, closed/merged ⇒ teardown, with a bot/label gate + inactivity TTL. The
# route is authenticated ONLY by the GitHub webhook HMAC signature — it is not an
# operator route — so this secret is REQUIRED for the feature to accept anything.
# Set the SAME value in the GitHub repo/org webhook config (Settings → Webhooks →
# Secret). With no secret the route returns 503 and never provisions.
GITHUB_WEBHOOK_SECRET=
# Feature flag env default (Config store, /app/config). OFF unless set. The webhook
# route no-ops (200) while off, so it's safe to wire the GitHub webhook before
# turning this on.
FLOTILLA_FEATURE_PR_NATIVE_LIFECYCLE=
# Cost guardrails (config-driven; a value saved in Config overrides these):
#   FLOTILLA_PR_REQUIRE_LABEL — a PR must carry this label before an instance is
#     provisioned. Blank disables the label gate (provision every eligible PR).
#     Default "preview" — a label is required (conservative).
#   FLOTILLA_PR_BOT_ALLOWLIST — comma-separated bot/agent logins (e.g.
#     "dependabot[bot],renovate[bot]") permitted to auto-provision. Blank = NO bots
#     (every detected bot/coding-agent PR is skipped). Default blank.
FLOTILLA_PR_REQUIRE_LABEL=preview
FLOTILLA_PR_BOT_ALLOWLIST=
# Inactivity-TTL pre-reap heads-up lead time (ms): how far ahead of expiry the
# worker sends the "expires in X — extend?" notification (before any teardown).
# Default 1800000 (30 min).
FLOTILLA_TTL_WARN_LEAD_MS=1800000

# --- AI failure triage (read-only) ---
# Powers the "Diagnose failure (AI)" card on the instance detail page: one
# forced-tool Anthropic call that explains WHY a failed instance failed. Gated by
# the aiFailureTriage feature flag (FLOTILLA_FEATURE_AI_FAILURE_TRIAGE) AND requires
# a key here — with no key the endpoint returns 409 "AI not configured".
# ANTHROPIC_API_KEY is sent only as the x-api-key header; never logged.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-6).
ANTHROPIC_TRIAGE_MODEL=claude-sonnet-4-6
# Feature flag env default (Config store, /app/config). OFF unless set.
FLOTILLA_FEATURE_AI_FAILURE_TRIAGE=

# --- Ask AI (global assistant) ---
# The floating "Ask AI" prompt on every page. Gated by the askAi feature flag
# below; when on, POST /api/ask routes through an ordered provider fallback chain
# (auto -> anthropic -> openai -> ollama -> free -> deterministic). The provider
# start point + optional model + Ollama URL are set in Config -> Ask AI (env
# defaults below). The deterministic tier is a non-AI keyword map, so Ask-AI never
# hard-fails even with no key. All API keys stay server-side; none are ever echoed.
FLOTILLA_FEATURE_ASK_AI=
# Default provider/chain start (auto|anthropic|openai|ollama|free|deterministic).
FLOTILLA_AI_PROVIDER=auto
# Optional model override passed to whichever provider answers (blank = default).
FLOTILLA_AI_MODEL=
# OpenAI provider — direct fetch to /v1/chat/completions. Skipped if unset.
OPENAI_API_KEY=
# Ollama provider — base URL of a local daemon (POST /api/chat). Skipped if
# unreachable. Not a secret (typically localhost).
OLLAMA_URL=http://localhost:11434
# "free" provider — OpenRouter's $0/$0 tier. OpenRouter needs a key even for free
# models, so this is skipped when unset. Sent only as the Authorization bearer.
OPENROUTER_API_KEY=

# --- Worker ---
# The standalone job worker executes provisions off the serverless request path:
#   npm run worker
# Set to 1 to ALSO execute jobs in-process (local dev / single-process deploy):
# FLOTILLA_INLINE_WORKER=1

# --- Clerk dashboard automation (Playwright) ---
CLERK_DASHBOARD_EMAIL=
CLERK_DASHBOARD_PASSWORD=

# Comma-separated operator emails allowed to log in via Clerk. REQUIRED when Clerk
# is enabled: an EMPTY/unset value denies ALL Clerk logins (fail-closed).
ALLOWED_EMAILS=

# Optional: worker periodically scans Convex cloud backups and ingests new ones
# into the GitHub snapshot store. Off unless set. Interval defaults to 1h.
# NOTE: these are the ENV DEFAULTS for the Config store (/app/config) —
# AUTO_INGEST_BACKUPS ↔ autoIngestEnabled, AUTO_INGEST_INTERVAL_MS ↔
# autoIngestIntervalMinutes. A value saved in Config overrides the env at runtime.
AUTO_INGEST_BACKUPS=
AUTO_INGEST_INTERVAL_MS=3600000

# --- Configuration store env defaults (/app/config) ---
# Persisted Config values override these at read-time; each is optional and falls
# back to a shipped default. Provisioning defaults (mask ↔ scrubPII, migrations,
# TTL), the default test kind, and appearance defaults.
FLOTILLA_MASK_BY_DEFAULT=true
FLOTILLA_MIGRATIONS_BY_DEFAULT=true
# --- PII mask hardening: per-deployment secret hash key -----------------------
# SECRET, env-only (NEVER a runtime Config key — the Config store forbids secrets;
# NEVER logged). When set, it is fed to @snaplet/copycat's setHashKey() and mixed
# into the HMAC-fallback key so masked identity values are salted by a credential
# an attacker does NOT have — defeating reversal via copycat's PUBLIC default seed
# + a known dataset. UNSET/blank ⇒ exactly today's default-seed behaviour (fully
# back-compat, no forced migration). Treat as a STABLE per-deployment credential:
# masking is deterministic *for a given key* (joins/rollups still line up), but
# CHANGING the key changes the ENTIRE mapping — a snapshot masked under a new key
# will not line up value-for-value with one masked under the old key (a fresh
# refresh under the new key IS still internally consistent). Use a long random
# value, e.g. `openssl rand -hex 32`. See lib/mask.ts, docs/SECURITY.md.
FLOTILLA_MASK_HASH_KEY=
# Auto-expire new instances after N hours; unset / blank = no TTL.
FLOTILLA_DEFAULT_TTL_HOURS=
FLOTILLA_DEFAULT_TEST_KIND=smoke
FLOTILLA_DEFAULT_ACCENT=indigo
FLOTILLA_DEFAULT_THEME=dark
# Flat USD/day rate for the ROUGH per-instance cost estimate (NOT real billing).
# Only surfaced when the costEstimates feature flag is on. Defaults to 0.50.
FLOTILLA_EST_COST_PER_INSTANCE_DAY=0.50
# Feature flag env default for cost visibility (Config store). OFF unless set.
FLOTILLA_FEATURE_COST_ESTIMATES=
# Fleet scorecards (Track D #7): a read-only, PURE hygiene score/grade per instance
# (owner set / mask verified / within TTL / monitoring on / drift clean / health) +
# a fleet rollup. OFF unless set — when off, GET /api/instances/scorecards 403s and
# the Scorecards section is absent; no other behaviour changes. See lib/scorecard.ts.
FLOTILLA_FEATURE_FLEET_SCORECARDS=
# Worker queue poll interval (ms); surfaced read-only in Config. Defaults 3000.
# FLOTILLA_WORKER_POLL_MS=3000
# Flag/rollout UX (Track-D #11): a stored feature-flag override that has been ON for
# longer than this many days is surfaced as "stale" (a rollout that was never cleaned
# up) in the Config → Features hints + GET /api/config's staleFlags. Detection only —
# it never changes resolution. Defaults to 30.
# FLOTILLA_FLAG_STALE_AFTER_DAYS=30

# --- Observability tab (metrics pipeline → MongoDB) ------------------------
# The Observability tab is feature-flagged. Nothing ingests or renders until the
# `observability` feature flag is ON (Config → Features, or
# FLOTILLA_FEATURE_OBSERVABILITY=1). The STORE is MongoDB — it reuses MONGODB_URI
# (above), no separate store creds. Absent Mongo the pipeline no-ops and the tab
# shows an honest empty state; with Mongo present it just works.
#
# (Axiom was the original store but its dataset-creation API 500s server-side, so
# the pipeline moved to Mongo. lib/clients/axiom.ts is kept dormant/unwired; the
# AXIOM_* vars below are OPTIONAL and unused by the active path — set only if you
# revive the Axiom client.)
FLOTILLA_FEATURE_OBSERVABILITY=
# Metrics retention: samples older than this many days are reaped by a Mongo TTL
# index on the metrics collection. Defaults to 30. NOTE: this is the ceiling on
# how deep the pollers' MAX-RETENTION backfill actually shows in the chart — the
# Atlas daily tier / Vercel year-of-cost / internal per-hour history are PULLED as
# far back as each provider retains, but points past this TTL get reaped. Raise it
# to keep deeper history (watch the metrics cluster's disk).
# FLOTILLA_METRICS_TTL_DAYS=30
# Optional (DORMANT — unused unless the Axiom client is revived):
# AXIOM_TOKEN=
# AXIOM_DATASET=flotilla-metrics
# AXIOM_ORG_ID=
# Metrics poll cadence for the worker sweep (ms). Defaults to 60000 (60s).
# FLOTILLA_METRICS_POLL_MS=60000
# Deep-backfill GATE cadence (ms). Every poll takes the cheap RECENT window (last
# ~15–30 min); the heavy DEEP backfill (Atlas multi-granularity to max period +
# Vercel full-year cost + internal 7d history) runs at most once per this interval.
# Defaults to 3600000 (1h). A fresh/empty store forces one immediate backfill, then
# settles into this cadence; force one ad-hoc via the poll route's ?backfill=1 or
# `metrics-poll --backfill`.
# FLOTILLA_METRICS_BACKFILL_INTERVAL_MS=3600000
# MongoDB Atlas poller (optional). Needs a Project-Read-Only API key: either a
# service-account bearer (ATLAS_API_TOKEN) OR a public/private Digest key pair
# (ATLAS_API_PUBLIC_KEY + ATLAS_API_PRIVATE_KEY), plus ATLAS_GROUP_ID (project id).
# Absent creds/group → the Atlas poller degrades to no points; the rest runs.
#
# The poller ingests the FULL unit-unambiguous measure set across process + disk +
# database endpoints and BACKFILLS each AS FAR BACK AS ATLAS RETAINS by iterating
# granularity tiers (PT1M/PT5M ≈ 48h, PT1H ≈ 63d, PT1D ≈ life-of-cluster). One
# point per historical datapoint; the store's idempotent upsert dedups tier overlap.
#
# ATLAS_PROCESS_ID is now OPTIONAL: set it to PIN one node (a volume escape-hatch);
# leave it UNSET to DISCOVER and ingest every process in the replica set (labeled
# by node) so no member is silently dropped.
ATLAS_API_TOKEN=
ATLAS_API_PUBLIC_KEY=
ATLAS_API_PRIVATE_KEY=
ATLAS_GROUP_ID=
ATLAS_PROCESS_ID=
# Optional backfill-tier override: comma-separated "granularity:period" pairs.
# Default: PT1M:PT48H,PT5M:PT48H,PT1H:P63D,PT1D:P720D. Trim it to cut per-poll
# volume (e.g. drop the PT1M tier) if the poll approaches the serverless timeout.
# These tiers are used ONLY on the periodic DEEP backfill (see the gate above).
# ATLAS_BACKFILL_TIERS=PT1M:PT48H,PT5M:PT48H,PT1H:P63D,PT1D:P720D
# Optional RECENT-tier override (same "granularity:period" form) — the cheap tier(s)
# every per-poll RECENT fetch uses. Default: PT1M:PT30M (last ~30 min at 1-min res).
# ATLAS_RECENT_TIERS=PT1M:PT30M
#
# SCOPE: the creds above cover the OBSERVABILITY cluster's OWN Atlas project (the
# dedicated metrics cluster). The MANAGED-app cluster is a DIFFERENT
# Atlas project — its process/disk/database metrics need THAT project's own
# Project-Read-Only key. To ingest the managed cluster, point ATLAS_GROUP_ID +
# ATLAS_API_* at the managed-app project (or run a second poll with those creds).
# (Vercel + Clerk pollers reuse the existing VERCEL_TOKEN / CLERK_SECRET_KEY.)
# Vercel COST/USAGE (vercel.cost.usd + vercel.cost.service_usd + vercel.usage.*,
# backfilled DAILY over the full ~1-year range via GET /v1/billing/charges) reuses
# VERCEL_TOKEN + VERCEL_TEAM; the team must have billing/usage access.

# --- Monitoring & scheduled sweeps (crons + alert email) -------------------
# Shared secret guarding the three Vercel cron routes (/api/observability/poll,
# /api/monitoring/run, /api/monitoring/escalate). Sent as `Authorization: Bearer
# $CRON_SECRET`; the routes fail CLOSED (401) when unset, so it is REQUIRED in any
# deployment that runs the crons. Compared in constant time.
CRON_SECRET=
# Monitoring email digests (nodemailer over Gmail SMTP). A Gmail address + an App
# Password (NOT the account password; spaces are stripped). Unset -> the email
# alert channel degrades off (Slack / webhook channels are unaffected).
ALERT_GMAIL_USER=
ALERT_GMAIL_APP_PASSWORD=
ALERT_FROM_NAME=flotilla
