{
  "name": "flotilla",
  "version": "0.1.0",
  "private": true,
  "description": "flotilla \u2014 operator console for provisioning, refreshing, and managing preview/staging application instances across Vercel + Convex + Clerk. Next.js + MongoDB + Clerk. See README.md.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "seed-demo": "node --experimental-strip-types --env-file=.env.local scripts/seed-demo.ts",
    "provision": "node --experimental-strip-types scripts/provision.ts",
    "refresh-staging": "node --experimental-strip-types scripts/refresh-staging.ts",
    "auto-refresh": "node --experimental-strip-types --env-file=.env.local scripts/auto-refresh.ts",
    "sync-backups": "node --experimental-strip-types --env-file=.env.local scripts/sync-backups.ts",
    "metrics-poll": "node --experimental-strip-types --env-file=.env.local scripts/metrics-poll.ts",
    "worker": "node --experimental-strip-types --env-file=.env.local scripts/worker.ts"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not IE 11"
  ],
  "dependencies": {
    "@clerk/nextjs": "^6.12.0",
    "@snaplet/copycat": "^6.0.0",
    "clsx": "^2.1.1",
    "mongodb": "^6.12.0",
    "next": "^16.0.1",
    "nodemailer": "^6.10.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.5.5",
    "uplot": "^1.6.32",
    "virtua": "^0.49.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}