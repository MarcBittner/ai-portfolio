# Grimoire environment. Copy to .env.local and fill in. The app BOOTS WITH ZERO
# KEYS (Clerk shim + in-memory store + offline AI), so none of these are required
# to run the public landing + library.

# ---- Database (persistence adapter — lib/db) ----
# MONGODB_URI set → MongoDB; unset → in-memory store (zero-credential dev/test).
MONGODB_URI=
MONGODB_DB=grimoire

# ---- Clerk (auth + optional Google OAuth) ----
# From dashboard.clerk.com. Enable Email (and Google if you want OAuth).
# When unset, the app runs unauthenticated (public landing + library render, the
# gated /app actions are read-only).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Frontend API URL / issuer, e.g. https://your-slug.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
# Verifies inbound Clerk webhooks (user.created etc.). From Clerk → Webhooks.
CLERK_WEBHOOK_SIGNING_SECRET=

# ---- Admin seeding (RBAC) ----
# Comma-separated emails auto-elevated to Super Admin on login (idempotent).
SEED_SUPER_ADMINS=admin@example.com
# Email domain allowed to self-sign-up. BLANK = open self-signup: any verified
# email may create a guest account (read the public library + edit own notes).
# Set to a domain (e.g. example.com) to restrict signup to that domain.
SIGNUP_ALLOWED_DOMAIN=
# Break-glass Super Admin (SSO-outage recovery). Store the HASH, not the password.
BREAKGLASS_EMAIL=
BREAKGLASS_PASSWORD_HASH=

# ---- Content source (optional git-backed source of truth) ----
# Local Markdown lives under DOCS_CONTENT_ROOT; the index bootstraps from it on
# load. Point GITHUB_* + DOCS_REPO at a repo for app-authored commits via the
# GitHub API store (durable), else the local content dir is used.
DOCS_CONTENT_ROOT=content
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
DOCS_REPO=your-org/your-docs
DOCS_BRANCH=main
ASSETS_REPO=your-org/your-docs-assets
# repo (content-addressed assets repo) | object (R2/S3, future)
ASSET_STORE=assetRepo
ASSET_MAX_FILE_MB=25
ASSET_MAX_BATCH_MB=100

# ---- AI (server-side only; never expose in the browser) ----
# All optional — with none set, AI degrades to OpenRouter-free / offline.
# Generation (primary = Anthropic):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OLLAMA_BASE_URL=
# Embeddings for RAG/semantic search (Voyage = Anthropic-recommended; falls back
# to a local hash embedder when unset):
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ---- Conversion sidecar (docx/pdf/etc → Markdown) ----
# Separate service behind a URL so it never embeds in the Next app.
CONVERSION_SERVICE_URL=

# ---- Collab WS service (live multi-cursor co-editing; services/collab) ----
# Dedicated WebSocket service URL; COLLAB_TOKEN is an optional shared secret.
COLLAB_WS_URL=
COLLAB_TOKEN=

# ---- Ingest (inbound content webhook — /api/ingest) ----
# INGEST_TOKEN is the required shared secret (x-ingest-token); ingest is disabled
# when unset. INGEST_BOT_EMAIL is the commit author for ingested content.
INGEST_TOKEN=
INGEST_BOT_EMAIL=ingest-bot@example.com
