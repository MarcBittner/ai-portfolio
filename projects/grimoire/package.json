{
  "name": "grimoire",
  "version": "0.1.0",
  "private": true,
  "description": "Grimoire — an offline-first, self-hostable knowledge base for AI. Sign in, read a curated library, keep your own notes. Markdown is the source of truth; WYSIWYG + raw editing, RBAC, per-user spaces, RAG search. Next.js + Clerk + MongoDB.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.0",
    "@octokit/rest": "^22.0.1",
    "@tiptap/extension-collaboration": "^3.27.1",
