# vigil runs fully with NO .env at all: it probes the public fleet, scores posture,
# and the LLM incident summarizer falls through to a deterministic offline drafter,
# so every number and narrative reproduces with zero keys and zero cost. Set any of
# the below to turn on a real surface. NEVER commit real keys; on a public host
# leave the credential ones unset (the app degrades gracefully + marks them
# NEEDS-CREDENTIAL in the UI and logs).

# --- Core (safe defaults) ---------------------------------------------------
# VIGIL_DB=/tmp/vigil.db
# VIGIL_SELF_URL=https://vigil-ukjh.onrender.com   # this instance's public URL
# VIGIL_POLL_INTERVAL=60                       # seconds between probe cycles
# VIGIL_ROLLING_WINDOW=50                      # probes per rolling availability window
# VIGIL_ADMIN_EMAIL=marc.bittner@gmail.com     # the single bootstrap admin

# --- Session secret (NEEDS-CREDENTIAL for prod) -----------------------------
# Set to a strong random value so sessions survive restarts / can't be forged.
# VIGIL_SECRET=replace-with-a-long-random-string

# --- LLM routing (incident summarizer) --------------------------------------
# auto (default) walks paid -> local -> free -> offline; or pin a tier.
# LLM_MODE=auto
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Social OAuth (NEEDS-CREDENTIAL) ----------------------------------------
# Providers register + their buttons appear ONLY when both id+secret are set.
# Redirect URI to register with each provider:
#   {VIGIL_SELF_URL}/auth/oauth/google/callback
#   {VIGIL_SELF_URL}/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# --- Email (verification links + email alerts) (NEEDS-CREDENTIAL) -----------
# Without these, verification links are logged to the server console (dev-usable).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-user
# SMTP_PASS=secret
# SMTP_FROM=alerts@example.com

# --- SMS alerts via Twilio (NEEDS-CREDENTIAL) -------------------------------
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+15555550123
